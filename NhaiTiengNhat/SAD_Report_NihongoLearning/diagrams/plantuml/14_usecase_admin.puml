@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #236B61
skinparam ArrowThickness 1.1
skinparam BorderColor #315C55
skinparam ActorBorderColor #315C55
skinparam ActorFontColor #203D39
skinparam UsecaseBorderColor #315C55
skinparam UsecaseBackgroundColor #F1F7F3
skinparam ComponentBorderColor #315C55
skinparam ComponentBackgroundColor #F1F7F3
skinparam ClassBorderColor #315C55
skinparam ClassBackgroundColor #F8FAF8
skinparam DatabaseBorderColor #315C55
skinparam DatabaseBackgroundColor #F1F7F3
skinparam linetype ortho
left to right direction
actor "Quản trị viên" as A
rectangle "Quản trị" {
  usecase "Xác minh role admin" as Gate
  usecase "Quản lý nội dung học" as Content
  usecase "Quản lý người dùng" as Users
  usecase "Đổi role / khóa tài khoản" as Roles
  usecase "Xem tiến độ học viên" as Progress
  usecase "Xem báo cáo tổng quan" as Reports
  usecase "Duyệt feedback" as Feedback
  usecase "Tải video và tài liệu" as Upload
  usecase "Quản lý bài học / bài tập" as Lessons
}
A --> Content
A --> Users
A --> Roles
A --> Progress
A --> Reports
A --> Feedback
A --> Upload
A --> Lessons
Content ..> Gate : <<include>>
Users ..> Gate : <<include>>
Feedback ..> Gate : <<include>>
Upload ..> Gate : <<include>>
@enduml
