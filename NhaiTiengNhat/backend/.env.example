# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nihongo_learning
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Server
PORT=3000
NODE_ENV=development

# CORS - frontend origin
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Bcrypt rounds
BCRYPT_ROUNDS=12

# VNPay Sandbox. Keep secrets in this ignored file, never in frontend code.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Set to a publicly reachable HTTPS URL before trying IPN/payment activation.
APP_PUBLIC_URL=
